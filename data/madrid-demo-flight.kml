<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
  <name>Madrid demo flight</name>
  <description>Simulated quadcopter flight from Santiago Bernabeu to Atocha with a 4S 3000 mAh pack: takeoff, cruise along Paseo de la Castellana, landing, then 30 s on the ground. Fake CRSF telemetry source for crsf-link-tester, sampled once per second from the fakelrsdrone simulation. Coordinates and altitudes are approximate and synthetic, not a real flight plan.
Track conventions: gx:coord altitude is GPS altitude above mean sea level; gx:angles are heading = yaw (0-360 deg), tilt = pitch (deg, nose up positive), roll (deg, right wing down positive). Waypoint placemarks are timestamped with the moment the aircraft reaches them.</description>
  <Style id="flight">
    <IconStyle><Icon><href>http://maps.google.com/mapfiles/kml/shapes/airports.png</href></Icon></IconStyle>
    <LineStyle><color>ff00aaff</color><width>3</width></LineStyle>
  </Style>
  <Schema id="telemetry" name="telemetry">
    <gx:SimpleArrayField name="ground_speed" type="float"><displayName>Ground speed (m/s)</displayName></gx:SimpleArrayField>
    <gx:SimpleArrayField name="course" type="float"><displayName>Course over ground (deg)</displayName></gx:SimpleArrayField>
    <gx:SimpleArrayField name="vertical_speed" type="float"><displayName>Vertical speed (m/s)</displayName></gx:SimpleArrayField>
    <gx:SimpleArrayField name="baro_altitude" type="float"><displayName>Barometric altitude above takeoff (m)</displayName></gx:SimpleArrayField>
    <gx:SimpleArrayField name="battery_voltage" type="float"><displayName>Battery voltage (V)</displayName></gx:SimpleArrayField>
    <gx:SimpleArrayField name="battery_current" type="float"><displayName>Battery current (A)</displayName></gx:SimpleArrayField>
    <gx:SimpleArrayField name="battery_used" type="float"><displayName>Battery capacity used (mAh)</displayName></gx:SimpleArrayField>
    <gx:SimpleArrayField name="battery_remaining" type="int"><displayName>Battery remaining (%)</displayName></gx:SimpleArrayField>
    <gx:SimpleArrayField name="satellites" type="int"><displayName>GPS satellites</displayName></gx:SimpleArrayField>
    <gx:SimpleArrayField name="flight_mode" type="string"><displayName>Flight mode</displayName></gx:SimpleArrayField>
    <gx:SimpleArrayField name="phase" type="string"><displayName>Flight phase</displayName></gx:SimpleArrayField>
  </Schema>
